    "highlight.js": "^11.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
